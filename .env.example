# ---------------------------------------------------------------------------
# Local Food — environment variables
#
# Copy this file to `.env` and fill in values. Everything here can run in a
# free / sandbox tier, so you can build and test end to end at zero cost.
#   cp .env.example .env
# NEVER commit your real .env file (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ----------------------------------------------
# Create a free project at https://neon.tech and paste the connection string.
# Prisma uses DATABASE_URL for queries and DIRECT_URL for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (Clerk) ----------------------------------------------------------
# Dashboard: https://dashboard.clerk.com  → use the Development instance keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Test-only vendor login for Playwright auth fixtures (E2E_*). Create this user
# in the Clerk dashboard's Development instance — never a real account.
# playwright/support/global-setup.ts authenticates as this user via Clerk's
# Backend API (CLERK_SECRET_KEY above) and writes playwright/.auth/vendor.json
# automatically before every `npx playwright test` run — no password needed,
# no manual step.
E2E_VENDOR_EMAIL="vendor-test@example.com"
# The above user's Clerk user id (starts with "user_"; find via Clerk dashboard
# or GET https://api.clerk.com/v1/users?email_address=... with CLERK_SECRET_KEY).
# prisma/seed.ts binds the seeded "Corner Sourdough" vendor to this id so the
# auth fixture keeps working after re-seeding. Leave blank to skip the binding.
E2E_VENDOR_CLERK_ID="user_..."
# Same pattern as E2E_VENDOR_EMAIL/E2E_VENDOR_CLERK_ID above, for the Admin
# identity (Story 2.1). Create a second test user in Clerk's Development
# instance and bind it via prisma/seed.ts's seeded Admin row.
E2E_ADMIN_EMAIL="admin-test@example.com"
E2E_ADMIN_CLERK_ID="user_..."

# --- Payments (Stripe, test mode) ------------------------------------------
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` or the webhook settings page (test mode).
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- SMS (Twilio) ----------------------------------------------------------
# "mock" (default, no external calls) or "twilio" (real sends). Leave unset or
# "mock" in local dev and CI; set to "twilio" only in production once Twilio
# is unblocked.
SMS_PROVIDER=mock
# Console: https://console.twilio.com  → use test credentials while developing.
# Only needed when SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_FROM_NUMBER="+15005550006"   # Twilio magic test number

# --- Images (Cloudinary) ---------------------------------------------------
# Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# --- Error monitoring (Sentry) ---------------------------------------------
# Optional locally. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
