// Prisma schema — the single source of truth for the database.
// Edit this file, then run `npm run prisma:migrate` to update the DB and
// regenerate the type-safe client.
//
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A platform operator, distinct from a Vendor. Admin-ness is resolved
// exclusively through this table's clerkUserId (architecture AD-1) — never
// a Clerk session claim. See src/lib/admin.ts's getCurrentAdmin().
//
model Admin {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  phone       String? // low-stock/shortfall SMS destination (Story 3.2) - nullable, mirrors Vendor.phone's shape; a zero-admins-with-a-phone state must degrade gracefully, not crash
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdVendors Vendor[] @relation("VendorCreatedByAdmin")
  deletedVendors Vendor[] @relation("VendorDeletedByAdmin")
}

// A seller on the marketplace. Owned by one Clerk user (clerkUserId) once
// claimed - nullable because an admin-created vendor starts unbound
// (AD-8, Story 2.2); binding happens manually, out-of-band, later.
model Vendor {
  id          String   @id @default(cuid())
  clerkUserId String?  @unique // links this storefront to a signed-in user; null until claimed (AD-8)
  name        String
  slug        String   @unique // used in the URL: /vendors/{slug}
  description String?
  // Nullable FK -> Admin.id (not Admin.clerkUserId - AD-5's attribution
  // rule), set only for admin-created vendors. Named relation because
  // Story 2.3 adds a second Vendor -> Admin relation (deletedByAdminId),
  // and Prisma requires distinct names once there are two. onDelete:
  // SetNull - losing attribution if an Admin row is ever deleted is
  // acceptable (AD-5: informational, not an audit log); it must not block
  // deleting the Admin row.
  createdByAdminId String?
  createdByAdmin   Admin?  @relation("VendorCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  // Soft-delete (Story 2.3, AD-4) - null means active. Never a hard delete;
  // assertVendorActive() is the sole check anywhere that cares. Slugs stay
  // permanently reserved even after deactivation (human decision, Story
  // 2.3 planning) - resolveVendorSlug() deliberately does not filter on
  // this, to avoid a bookmarked/shared storefront URL ever resolving to a
  // different, unrelated vendor.
  deletedAt        DateTime?
  // Second Vendor -> Admin relation, same shape as createdByAdminId above -
  // this is exactly why that one was given an explicit name up front.
  deletedByAdminId String?
  deletedByAdmin   Admin?    @relation("VendorDeletedByAdmin", fields: [deletedByAdminId], references: [id], onDelete: SetNull)
  imageUrl    String? // Cloudinary URL for a banner/logo
  phone       String? // vendor contact number
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
  orders      Order[]
  pickupSlots PickupSlot[]
}

// Something a vendor sells. Price is stored in cents to avoid float rounding.
model Product {
  id           String   @id @default(cuid())
  vendorId     String
  name         String
  description  String?
  priceCents   Int // e.g. 1250 == $12.50
  imageUrl     String? // Cloudinary URL
  stockQuantity     Int // required at creation, no schema default - vendor must set it (Story 1.2)
  lowStockThreshold Int // required at creation, no schema default - vendor must set it (Story 1.2)
  // True only for the migration-backfilled 0 (Story 1.2 review). Cleared to
  // false on any vendor-initiated write to lowStockThreshold, regardless of
  // the value chosen - this is what lets Story 1.6 tell a placeholder 0
  // apart from a vendor's deliberate 0.
  thresholdIsPlaceholder Boolean @default(false)
  // Same idea as thresholdIsPlaceholder, for the migration-backfilled 100 -
  // a vendor's deliberate stockQuantity of 100 is at least as plausible as
  // the threshold's deliberate 0, so it needs the identical guard.
  stockIsPlaceholder     Boolean @default(false)
  // Monotonic counter, bumped by every writer of stockQuantity (setStock,
  // decrementStock) - never by setLowStockThreshold, which has no
  // concurrent writer of its own (see its doc comment). Closes the
  // ABA gap a plain stockQuantity-equality optimistic lock has: a
  // decrement-then-restock between the vendor's page load and their save
  // can return stockQuantity to the exact value the vendor's stale read
  // saw, which a value-equality guard can't tell apart from "unchanged"
  // (Story 1.2 deferred-work finding).
  stockVersion Int @default(0)
  // One-shot flag, same shape as Order.smsNotified (Story 3.2). Set true
  // only after a low-stock SMS actually sends (never before - a failed
  // send must leave this false). Reset to false by setStock() when a
  // genuine restock brings stockQuantity back above lowStockThreshold,
  // so a future crossing can alert again (AC #5).
  lowStockAlerted Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Restrict, not Cascade (Story 2.3, AC #4) - a Vendor is only ever
  // soft-deleted (deletedAt), never hard-deleted, so this should never
  // actually fire in normal operation. It exists as a defense-in-depth
  // guard: an accidental prisma.vendor.delete() must fail loudly (existing
  // Products would block it) rather than silently destroy order history.
  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([vendorId])
}

// A window during which customers can pick up their orders.
model PickupSlot {
  id        String   @id @default(cuid())
  vendorId  String
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int      @default(20) // max orders for this window
  location  String?
  createdAt DateTime @default(now())

  vendor Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([vendorId])
}

// One customer purchase. Moves through the OrderStatus lifecycle.
model Order {
  id                String      @id @default(cuid())
  vendorId          String
  pickupSlotId      String?
  customerName      String
  customerPhone     String // used for the Twilio SMS confirmation
  status            OrderStatus @default(PENDING)
  totalCents        Int
  stripeSessionId   String?     @unique // links back to Stripe Checkout
  smsNotified       Boolean     @default(false)
  stockDecremented  Boolean     @default(false) // set inside the same $transaction as the per-line decrements (Story 1.4) - a separate guard from `status` so a retry after a transient failure (deadlock, dropped connection) between the PAID commit and the decrement re-attempts cleanly instead of finding status already PAID and giving up
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Restrict, not Cascade - same reasoning as Product.vendor above.
  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  pickupSlot PickupSlot? @relation(fields: [pickupSlotId], references: [id])
  items      OrderItem[]

  @@index([vendorId])
  @@index([status])
}

// A line item on an order. quantity x unitPriceCents.
model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int    @default(1)
  unitPriceCents Int // price captured at time of order

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

enum OrderStatus {
  PENDING // created, awaiting payment
  PAID // Stripe webhook confirmed payment
  READY // vendor marked it ready for pickup
  COMPLETED // picked up
  CANCELLED
}
